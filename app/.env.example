# Supabase (Vercel Marketplace injects these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (no trailing slash)
APP_URL=https://app.fusedprotectiveservices.com

# Email (Resend) — DISPATCH_ALERT_FROM must be a verified sender
RESEND_API_KEY=
DISPATCH_ALERT_FROM="Fused Dispatch <dispatch@fusedprotectiveservices.com>"
DISPATCH_ALERT_TO=
DISPATCH_ALERT_SMS_TO=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduler — Vercel Cron sends this as a bearer token
CRON_SECRET=

# Tests only
TEST_DATABASE_URL=postgres://localhost/fused_test
