{
  "name": "fused-portal",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "version": "0.1.0",
  "description": "Fused Protective Services operations platform — owner portal, client portal, payments, notifications.",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "dev": "node scripts/sync-shared.mjs && next dev",
    "build": "node scripts/sync-shared.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/sync-shared.mjs && tsc --noEmit",
    "test": "node scripts/sync-shared.mjs && vitest run",
    "test:db": "node scripts/reset-test-db.mjs && node scripts/sync-shared.mjs && vitest run tests/db",
    "test:all": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@sentry/nextjs": "10.74.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "pg": "8.23.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
